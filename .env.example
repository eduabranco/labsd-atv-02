# MySQL Configuration Environment Variables (Optional)
# Copy this file to .env and customize as needed
# Note: config_db.py (generated by db_setup.py) takes precedence over these

MYSQL_USER=ddb_user
MYSQL_PASSWORD=ddb_pass
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=dist_db
MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
